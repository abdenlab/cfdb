# Keep the Docker build context (COPY . /app in Dockerfile.api and
# Dockerfile.wool) free of VCS history, virtualenvs, build/test caches,
# and large local data files so images stay small and don't leak history.

# Version control
.git
.github
.gitignore

# Python virtualenv and caches
.venv
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.hypothesis

# Rust materializer build artifacts
materialize/target

# Local data, scratch, and tooling
.data
.sandbox
.understand-anything
.claude
build
.encode_metadata.tsv

# Locally-generated mTLS material (make worker-certs / make certs). Every
# runtime path that needs these reads them from env-injected files at
# container start (see cfdb-tls-entrypoint.sh), never from a path baked
# into the image, so nothing under here belongs in the build context. A
# gitignored file is not a dockerignored one -- without this, a local
# `docker build` run after `make worker-certs` silently bakes the
# generated private keys into the image.
certs/*.pem
certs/**/*.pem

# Tests are not needed in the runtime image
tests

# Editor / OS cruft
.DS_Store
*.swp
